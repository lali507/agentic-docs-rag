# Provider for chat + embeddings. When OPENAI_API_KEY is set, OpenAI is used automatically.
# Key from https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Or a free Cohere key, from https://dashboard.cohere.com/api-keys
COHERE_API_KEY=
# Optional. Free key from https://app.pinecone.io; when empty, vectors are stored locally
# in data/structured/vector_store/
PINECONE_API_KEY=

# Optional settings
# LLM_PROVIDER=openai            # openai | cohere
# OPENAI_LLM_MODEL=gpt-4.1-mini
# EMBED_MODEL=text-embedding-3-small
# PINECONE_INDEX=agentic-docs-openai
# Project folders to scan, separated by commas
# DOCS_ROOTS=data/sample_project
# RAG_TOP_K=6
# RAG_MIN_SCORE=0.20
# RAG_CONFIDENCE_THRESHOLD=0.35
